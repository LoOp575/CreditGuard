# No provider credentials are required by the MCP foundation.
NODE_ENV=development
LOG_LEVEL=info

# PostgreSQL state. Apply migrations 001_credit_ledger.sql and 002_project_loop_checkpoint.sql before starting MCP.
# Empty DATABASE_URL selects the in-memory development ledger only.
DATABASE_URL=postgresql://credit_guard:local_dev_only_change_me@localhost:5432/credit_guard
REDIS_URL=

# Future gateway settings
GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=8787
