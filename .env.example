# No provider credentials are required by the MCP foundation.
NODE_ENV=development
LOG_LEVEL=info

# PostgreSQL state. Apply migrations 001, 002, and 003 before starting MCP or Gateway.
# Empty DATABASE_URL selects the in-memory development ledger only.
DATABASE_URL=postgresql://credit_guard:local_dev_only_change_me@localhost:5432/credit_guard
REDIS_URL=

# Gateway settings. Keep tokens and provider keys in a secret manager in production.
GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=8787
GATEWAY_PROJECT_TOKENS_JSON={}
PROVIDER_API_KEYS_JSON={}
# Configure verified rates using provider:model keys. Empty config fails closed for model calls.
PROVIDER_PRICING_JSON={}
# Optional same-provider fallback map: provider:requestedModel -> cheaperModel
MODEL_FALLBACKS_JSON={}
ESTIMATE_SAFETY_MULTIPLIER=1.5
# Decision policy percentages (0-100)
GUARD_LOW_REMAINING_BUDGET_PERCENT=10
GUARD_LOW_PROGRESS_PERCENT=10
# Secret held only by a trusted verifier/operator, not by the Agent
EVIDENCE_VERIFIER_TOKEN=
